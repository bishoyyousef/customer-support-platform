# Customer Support Platform Monorepo Environment Configuration Example

# Backend REST API
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/customer_support?retryWrites=true&w=majority
MONGODB_DB_NAME=customer_support
JWT_SECRET=<your-strong-random-jwt-secret>
ALLOWED_ORIGINS=https://customer-portal.yourdomain.com,https://support-workspace.yourdomain.com

# React Customer Portal
VITE_API_BASE_URL=https://api.yourdomain.com/api

# Angular Support Workspace
API_URL=https://api.yourdomain.com/api
